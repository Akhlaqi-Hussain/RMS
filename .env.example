# RMS — example settings. Copy this file to `.env.local` and fill in your own values.
# `.env.local` is private: Git ignores it, so it is never committed or shared.
# NEVER put real passwords in this example file.

# --- App → database connection (read by lib/db.js) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=rms_app
DB_PASSWORD=change-me-app-password
# rms_dev for daily development, rms_test when running automated tests
DB_NAME=rms_dev

# --- Login tokens (read by app/api/login and lib/auth.js) ---
# Use a long random value (at least 32 characters). Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# Login cookie over plain http on the restaurant network (PROD-2).
# With `npm start` the cookie is "secure" (HTTPS only) unless this is false.
# Set false when phones/tablets/other PCs open http://<PC-address>:3000.
# COOKIE_SECURE=false

# --- Docker database administrator (used only by docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- Backups (read by scripts/backup.mjs, scripts/restore.mjs and the dashboard) ---
# All optional. Backups are kept OUTSIDE the project folder.
# BACKUP_DIR=../rms-backups
# Second copy on another disk / USB / network share (strongly recommended):
# BACKUP_COPY_DIR=E:\RMS-backups
# How many backups of each kind to keep:
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=5
# BACKUP_KEEP_MONTHLY=12
# BACKUP_KEEP_MANUAL=10
# BACKUP_KEEP_PRE_RESTORE=5
# docker (default, database in Docker) or direct (mysqldump/mysql installed on this computer)
# BACKUP_MODE=docker
# The schedule is set in the app (Manage → Backups). "off" switches the in-app schedule off,
# e.g. when only the Windows scheduled task (scripts\windows\schedule-backup.ps1) should run.
# BACKUP_SCHEDULER=on
