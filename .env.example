# RMS — example settings. Copy this file to `.env.local` and fill in your own values.
# `.env.local` is private: Git ignores it, so it is never committed or shared.
# NEVER put real passwords in this example file.

# --- App → database connection (read by lib/db.js) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=rms_app
DB_PASSWORD=change-me-app-password
# rms_dev for daily development, rms_test when running automated tests
DB_NAME=rms_dev

# --- Login tokens (read by app/api/login and lib/auth.js) ---
# Use a long random value (at least 32 characters). Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# --- Docker database administrator (used only by docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=change-me-root-password
